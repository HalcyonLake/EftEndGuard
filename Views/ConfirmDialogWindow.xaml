<Window x:Class="EftEndGuard.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="战局结算确认"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        ShowActivated="True"
        Focusable="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- MD3 线性进度条（圆角轨道 + 主色填充） -->
        <Style x:Key="Md3LinearProgressReject" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#3A0F12"/>
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Md3LinearProgressAllow" TargetType="ProgressBar" BasedOn="{StaticResource Md3LinearProgressReject}">
            <Setter Property="Background" Value="#0A2A3F"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- 按键徽章 Keycap -->
        <Style x:Key="KeycapBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#00000040"/>
        </Style>
    </Window.Resources>

    <!-- 主容器：磨砂半透明 SurfaceContainerHigh -->
    <Border CornerRadius="28" Background="#E6282A31">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.45" Direction="270"/>
        </Border.Effect>

        <!-- 外层 ScrollViewer：当窗口高度被工作区夹取（小屏 / 高缩放）时内容可滚动，避免显示不全 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,18">

            <!-- ===== 标题栏：标题 + 倒计时胶囊 ===== -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource TertiaryContainerBrush}" CornerRadius="10"
                            Width="30" Height="30" VerticalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource OnTertiaryContainerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="检测到战局结算上传" Style="{StaticResource Md3TitleMedium}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- 倒计时胶囊 -->
                <Border Grid.Column="1" Background="{StaticResource TertiaryContainerBrush}"
                        CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CountdownText}" FontSize="11"
                               Foreground="{StaticResource OnTertiaryContainerBrush}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>

            <!-- ===== 请求详情（紧凑） ===== -->
            <Border Background="{StaticResource SurfaceContainerBrush}" CornerRadius="16" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="METHOD  " Style="{StaticResource Md3LabelSmall}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Method}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnTertiaryContainerBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="PATH  " Style="{StaticResource Md3LabelSmall}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Host}" FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Margin="0,0,0,6"/>
                    <!-- 长按/单击 模式提示 -->
                    <TextBlock Text="{Binding ArmedHint}" Style="{StaticResource Md3BodySmall}"/>
                </StackPanel>
            </Border>

            <!-- ===== 操作区：拒绝 / 允许 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 拒绝块 (ErrorContainer) -->
                <Border Grid.Column="0" Background="{StaticResource ErrorContainerBrush}" CornerRadius="16"
                        Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Border Style="{StaticResource KeycapBadge}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RejectHotkeyText}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource OnErrorContainerBrush}"/>
                            </Border>
                            <TextBlock Text="拒绝并回滚" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnErrorContainerBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ProgressBar Style="{StaticResource Md3LinearProgressReject}"
                                     Value="{Binding RejectHoldProgress, Mode=OneWay}"
                                     Visibility="{Binding IsHoldMode, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding RejectHoldPercentText}" FontSize="10"
                                   Foreground="{StaticResource OnErrorContainerBrush}" Opacity="0.8"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"
                                   Visibility="{Binding IsHoldMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- 允许块 (PrimaryContainer) -->
                <Border Grid.Column="2" Background="{StaticResource PrimaryContainerBrush}" CornerRadius="16"
                        Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Border Style="{StaticResource KeycapBadge}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AllowHotkeyText}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource OnPrimaryContainerBrush}"/>
                            </Border>
                            <TextBlock Text="允许上传" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnPrimaryContainerBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ProgressBar Style="{StaticResource Md3LinearProgressAllow}"
                                     Value="{Binding AllowHoldProgress, Mode=OneWay}"
                                     Visibility="{Binding IsHoldMode, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding AllowHoldPercentText}" FontSize="10"
                                   Foreground="{StaticResource OnPrimaryContainerBrush}" Opacity="0.8"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"
                                   Visibility="{Binding IsHoldMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>


